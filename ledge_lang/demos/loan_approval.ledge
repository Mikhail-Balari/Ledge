# Loan approval - bundled demo for `ledge demo loan_approval`.
#
# Synthetic demo only. Not a credit model. Not a lending decision system.
# This example is for evaluating Ledge's AI decision-boundary mechanics:
# deterministic checks, confidence-gated AI use, human review fallback, and
# audit-chain verification.
#
# Run it:                       ledge demo loan_approval
# Check only:                   ledge check --types ledge_lang/demos/loan_approval.ledge

define MIN_CONFIDENCE as 0.85
define MAX_DTI as 0.43

type LoanApplication has:
    id:        text
    applicant: text
    amount:    number
    income:    number
    debts:     number
    history:   text

define evaluate_loan(app: LoanApplication):
    requires:
        app.income > 0
        app.amount > 0

    # Deterministic rule: debt-to-income is checked before AI is consulted.
    define dti as round(divide(app.debts, app.income) or 0, 2)

    if dti > MAX_DTI:
        show "APPLICATION {app.id} ({app.applicant}): RULE-BASED DECLINE"
        show "  Source: deterministic DTI rule"
        show "  Reason: DTI={dti} exceeds demo threshold {MAX_DTI}"
        return "declined_dti"

    # AI-derived signal: narrative credit history is uncertain until confidence
    # handling is explicit. Without a backend, confidence is 0.
    define risk as classify(app.history) using ["low_risk", "medium_risk", "high_risk"]

    if confidence_of(risk) >= MIN_CONFIDENCE:
        # This branch requires a backend-provided high-confidence AI result.
        define risk_label as value_of(risk)
        if risk_label = "low_risk":
            show "APPLICATION {app.id} ({app.applicant}): AI-GATED DEMO APPROVAL"
            show "  Source: AI-derived risk label after confidence guard"
            show "  Amount={app.amount} | Risk={risk_label} | Confidence={confidence_of(risk)}"
            return "approved"

        show "APPLICATION {app.id} ({app.applicant}): AI-GATED DEMO DECLINE"
        show "  Source: AI-derived risk label after confidence guard"
        show "  Risk={risk_label} | Confidence={confidence_of(risk)}"
        return "declined_risk"
    else:
        show "APPLICATION {app.id} ({app.applicant}): HUMAN REVIEW"
        show "  Source: AI-derived signal below threshold"
        show "  Amount={app.amount} | DTI={dti} | AI confidence={confidence_of(risk)}"
        show "  Reason: confidence below {MIN_CONFIDENCE}; no automatic action"
        return "pending"

define applications as list [
    LoanApplication(id="L001", applicant="Maria Santos", amount=25000, income=85000, debts=12000, history="Consistent payment history 8 years credit no defaults excellent standing"),
    LoanApplication(id="L002", applicant="James Cooper", amount=40000, income=52000, debts=28000, history="Two missed payments last year recovering credit score some delinquencies"),
    LoanApplication(id="L003", applicant="Priya Nair", amount=15000, income=95000, debts=8000, history="Excellent credit history 12 years zero delinquencies highest credit score tier")
]

show "=== SYNTHETIC LOAN APPROVAL DECISION BOUNDARY DEMO ==="
show "Synthetic demo only. Not a credit model. Not a lending decision system."
show "Pattern: deterministic DTI rule + confidence-gated AI risk signal + human review fallback"
show "Backend: none; AI confidence is 0 unless a backend is configured"
show "Confidence threshold: {MIN_CONFIDENCE}"
show ""

for each app in applications:
    evaluate_loan(app)

show ""
show "Audit entries recorded: {len(audit_query())}"
show "Audit chain intact: {audit_verify()}"
show ""
show "Demo result: deterministic rule decisions are labeled separately."
show "Demo result: no AI-derived approval occurs when confidence is 0."
